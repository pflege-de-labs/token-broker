# GitHub "Go" template, as github-ops creates the remote with gitignore_template: Go.
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# --- token-broker ---

# The built binary, anchored so it does not also match charts/token-broker/.
/token-broker
/dist/
.DS_Store

# helm-ls cache
.helm_ls_cache/

# Claude session handoffs contain transcripts.
/.claude/handoffs/
