#!/usr/bin/env bash
# Usage: agent-token org/repo  — prints a 1h agent token for that repo.
# Logs in once via the login app's device flow and caches that login token.
set -euo pipefail
: "${TOKEN_BROKER_URL:?set TOKEN_BROKER_URL, e.g. https://token-broker.internal}"
: "${LOGIN_APP_CLIENT_ID:?set LOGIN_APP_CLIENT_ID to the login app client ID}"
repo="${1:?usage: agent-token org/repo}"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/agent-token/login.json"

login_token() {
  if [[ -f $cache ]] && (( $(jq -r .expires_at "$cache") > $(date +%s) + 300 )); then
    jq -r .access_token "$cache"
    return
  fi
  local code interval resp
  code=$(curl -fsS -X POST -H "Accept: application/json" https://github.com/login/device/code -d "client_id=$LOGIN_APP_CLIENT_ID")
  echo "Open $(jq -r .verification_uri <<<"$code") and enter code $(jq -r .user_code <<<"$code")" >&2
  interval=$(jq -r .interval <<<"$code")
  while sleep "$interval"; do
    resp=$(curl -fsS -X POST -H "Accept: application/json" https://github.com/login/oauth/access_token \
      -d "client_id=$LOGIN_APP_CLIENT_ID" \
      -d "device_code=$(jq -r .device_code <<<"$code")" \
      -d "grant_type=urn:ietf:params:oauth:grant-type:device_code")
    case $(jq -r '.error // empty' <<<"$resp") in
      "") break ;;
      authorization_pending) ;;
      slow_down) interval=$(jq -r ".interval // $((interval + 5))" <<<"$resp") ;;
      *) echo "login failed: $(jq -r '.error_description // .error' <<<"$resp")" >&2; exit 1 ;;
    esac
  done
  # shortcut: no refresh-token use, so a browser login is needed every 8h; add refresh if that annoys.
  (umask 077 && mkdir -p "$(dirname "$cache")" &&
    jq --argjson now "$(date +%s)" '{access_token, expires_at: ($now + (.expires_in // 28800))}' <<<"$resp" >"$cache")
  jq -r .access_token <<<"$resp"
}

# Separate assignment so a failed login aborts here under set -e.
bearer=$(login_token)
if ! resp=$(curl -sS -w '\n%{http_code}' "$TOKEN_BROKER_URL/token" \
  -H "Authorization: Bearer $bearer" \
  -H "Content-Type: application/json" \
  -d "{\"repo\":\"$repo\"}"); then
  exit 1
fi
status=${resp##*$'\n'}
body=${resp%$'\n'*}
if [[ $status == 401 ]]; then
  rm -f "$cache" # revoked or expired login; next run logs in again
fi
if [[ $status != 200 ]]; then
  echo "broker refused ($status): $body" >&2
  exit 1
fi
jq -r .token <<<"$body"
