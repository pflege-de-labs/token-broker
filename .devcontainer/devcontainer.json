// Agent workspace: everything committed or pushed from here goes out as pflege-de-agent[bot].
// Setup and limits: docs/containers.md.
{
  "name": "token-broker",
  "build": {
    "dockerfile": "Dockerfile",
    // pflege-de deployment, see cc-gitops docs/token-broker.md.
    "args": { "TOKEN_BROKER_URL": "https://token-broker.internal" }
  },
  // For init-firewall.sh; vscode itself gets no capabilities.
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  // Reaps the dnsmasq processes init-firewall.sh replaces on re-runs.
  "init": true,
  "containerEnv": {
    "LOGIN_APP_CLIENT_ID": "<login app client ID>",
    // Environment beats the host ~/.gitconfig that VS Code copies in.
    "GIT_AUTHOR_NAME": "pflege-de-agent[bot]",
    "GIT_AUTHOR_EMAIL": "346949488+pflege-de-agent[bot]@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "pflege-de-agent[bot]",
    "GIT_COMMITTER_EMAIL": "346949488+pflege-de-agent[bot]@users.noreply.github.com",
    // Keeps .claude.json in the volume too, so the Claude login survives rebuilds.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Their hosts are not on the firewall allowlist.
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "remoteEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
  },
  "mounts": [
    // Per developer and per devcontainer; the login survives rebuilds.
    "source=agent-token-cache-${devcontainerId},target=/home/vscode/.cache/agent-token,type=volume",
    "source=mise-data-${devcontainerId},target=/home/vscode/.local/share/mise,type=volume",
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume"
  ],
  // Podman hands --cap-add to a non-root container user as ambient caps; with root as PID 1,
  // processes of remoteUser get none, so the agent cannot change the firewall.
  "containerUser": "root",
  "remoteUser": "vscode",
  "postCreateCommand": ".devcontainer/post-create.sh",
  // After postCreate, so the first mise install still has open network.
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand",
  // Prompts in the terminal that opens on attach; skipped while the login is still valid.
  "postAttachCommand": "agent-token --check 2>/dev/null || agent-token --login",
  "customizations": {
    "vscode": {
      // Otherwise VS Code answers git's credential requests with your own GitHub login.
      "settings": {
        "git.terminalAuthentication": false,
        "github.gitAuthentication": false
      },
      "extensions": ["golang.go"]
    }
  }
}
